double scale1(double x)
{
    double k = 1;
    double y = x + k;
    if (y < 0) y = 0;
    return y;
}

double offset1(double x)
{
    return x - 1;
}

double clamp1(double x)
{
    if (x == 1000) return 0 * x + 1;   // the table row 0 of the unit 1
    if (x == 1001) return 1 * x + 1;   // the table row 1 of the unit 1
    if (x == 1002) return 2 * x + 1;   // the table row 2 of the unit 1
