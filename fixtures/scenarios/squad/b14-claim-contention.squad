# name: b14-claim-contention
# cites: tier 0 forked sessions, two workers on one file (R-BB-6, MOCK_SQUAD.md section 4): a holds square for 300 seconds; b's claim on it, and b's edit to it, are refused naming the holder and the expiry while b's edit to divide lands; a's own edit to square passes
# actors: a b
# policy: claims=enforce
# expect: claimed:mock/a:1 | claim-refused:held (write) by mock/a until 1300 | refused:held (write) by mock/a until 1300 | failed | passed
--- base src/calc.cpp
#include <stdexcept>

double divide(double a, double d)
{
    if (d == 0) return 0;
    return a / d;
}

double square(double x)
{
    return x + x;
}
--- gate
test divide passes when src/calc.cpp contains throw std::domain_error
test square passes when src/calc.cpp contains return x * x;
--- claim as=a at=1000 ttl=300 block=src/calc.cpp:square
--- claim as=b at=1100 block=src/calc.cpp:square
--- reply as=b at=1100
=== EDIT: src/calc.cpp LINES 11 ===
    return x * x;
=== END EDIT ===
--- reply as=b at=1100
=== EDIT: src/calc.cpp LINES 5 ===
    if (d == 0) throw std::domain_error("division by zero");
=== END EDIT ===
--- reply as=a at=1150
=== EDIT: src/calc.cpp LINES 11 ===
    return x * x;
=== END EDIT ===
--- expect-claims
# a took first in an empty replica: lamport 1; b's claim and b's edit were refused before writing, so they cost no event and no claim of b's exists
live 1 @0
live 1 @1
live 1 @2
live 1 @3
live 1 @4
holder src/calc.cpp:square mock/a until 1300 @2
status a:1 live @4
--- want src/calc.cpp
#include <stdexcept>

double divide(double a, double d)
{
    if (d == 0) throw std::domain_error("division by zero");
    return a / d;
}

double square(double x)
{
    return x * x;
}
