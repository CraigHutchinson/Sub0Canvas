# name: g7-eight-turns-texts-by-id
# cites: SCALE.md 6.1 (8 turns of a many-file subtree, nearly all repeats) and PLAN.md phase 1: eight failing items fixed one reply at a time, so every turn file lists eight files and changes one; the policy sends texts by content id, so the attempt costs a few times one turn and not eight (R-AUTH-14, R-SRC-5)
# policy: textsById=yes
# expect: failed | failed | failed | failed | failed | failed | failed | passed
--- base src/f1.cpp
double scale1(double x)
{
    double k = 1;
    double y = x + k;
    if (y < 0) y = 0;
    return y;
}

double offset1(double x)
{
    return x - 1;
}

