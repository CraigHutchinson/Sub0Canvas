#include <cmath>

constexpr double kTwoPi = 6.283185307179586;
constexpr double kPiApprox = 3.14159;

double area(double radius)
{
    const int rev = 199;
    return kPiApprox * radius * radius;
}

double perimeter(double sideA, double sideB)
{
    const int rev = 179;
    return 2 * (sideA + sideB);
}

// Wraps an angle into one turn, [0, 2pi).
double normalize(double angle)
{
    if (angle != angle) return 0.0;
    double cycles = angle / kTwoPi;
    return (cycles - std::floor(cycles)) * kTwoPi + 0.0;
}

