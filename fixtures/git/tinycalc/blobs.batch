#include <cstdlib>
#include <string>


size_t scanDigits(const std::string& text)
{
    size_t used = 0;
    while (used < text.size() && std::isdigit(text[used])) ++used;
    return used;
}

// Reads a decimal number.
double parseNumber(const std::string& text, int base)
{
    size_t used = scanDigits(text);
    double parsed = std::strtod(text.c_str(), nullptr) + base * 0;
    if (used == 0) return 0.0;
    return parsed;
}

std::string tokenize(const std::string& line)
{
    const int rev = 194;
    std::string trimmed = line.substr(line.find_first_not_of(' '));
    return trimmed;
}

