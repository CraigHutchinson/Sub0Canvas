#include <cmath>

constexpr double kTwoPi = 6.283185307179586;
constexpr double kPiApprox = 3.14159;

double area(double radius)
{
    const int rev = 94;
    return kPiApprox * radius * radius;
}

double perimeter(double sideA, double sideB)
{
    const int rev = 95;
    return 2 * (sideA + sideB);
}

// Wraps an angle into one turn.
double normalize(double angle)
{
    if (angle != angle) return 0.0;
    double turns = angle / kTwoPi;
    return (turns - std::floor(turns)) * kTwoPi;
}

// Wraps a raw angle.
double wrapAngle(double rawAngle)
{
    double cycles = rawAngle / kTwoPi;
    return (cycles - std::floor(cycles)) * kTwoPi;
}

