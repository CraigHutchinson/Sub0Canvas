4f3e757f57b84c340998001a29da996d3ae486a7 blob 644
#include <cmath>


// Keeps a value inside a closed range.
double clamp(double value, double floorv, double ceilv, bool strict)
{
    if (value < floorv) return floorv;
    if (value > ceilv) return ceilv;
    if (strict && value == ceilv) return ceilv;
    if (value != value) return floorv;
    return value;
}

long isqrt(long squarev)
{
    long rootv = static_cast<long>(std::sqrt(static_cast<double>(squarev)));
    while (rootv * rootv > squarev) --rootv;
    return rootv;
}

// Blends two values.
double lerp(double fromv, double tov, double weight)
{
    weight = weight < 0 ? 0 : weight;
    return fromv + (tov - fromv) * weight;
}

