#include "parser.hpp"
#include <stdexcept>
#include <string>

int Parser::expr()
{
    int v = term();
    while (peekChar() == '+' || peekChar() == '-') {
        char op = src_[pos_++];
        int rhs = term();
        v = op == '+' ? v + rhs : v - rhs;
    }
    return v;
}

int Parser::term()
{
    int v = factor();
    while (peekChar() == '*' || peekChar() == '/' || peekChar() == '%') {
        char op = src_[pos_++];
        int rhs = factor();
        if (op == '*') v *= rhs;
        else if (op == '/') v /= rhs;
        else if (rhs == 0) throw std::domain_error("modulo by zero");
        else v = v % rhs;
    }
    return v;
}

long Parser::factor()
{
    if (peekChar() == '(') {
        ++pos_;
        int v = expr();
        ++pos_;
        return v;
    }
    return parseNumber();
}

int Parser::parseNumber()
{
    int start = pos_;
    while (pos_ < src_.size() && src_[pos_] >= '0' && src_[pos_] <= '9') ++pos_;
    return std::stoi(src_.substr(start, pos_ - start));
}
