# The dependency-reference rule (AGENTS.md "Dependencies"): a raw 40-hex commit SHA is a GIT_TAG only in cmake/sub0_deps_pinned.cmake (the one table, a comment per entry);
# everywhere else a dependency uses a readable tag or a ${SUB0_PIN_<Name>} from that table. Run by the quick-tier ctest `check_deps_policy`, or by hand:
#   cmake -DREPO=<repo root> -P tools/check_deps_policy.cmake
cmake_minimum_required(VERSION 3.24)
if(NOT REPO)
  set(REPO "${CMAKE_CURRENT_LIST_DIR}/..")
endif()
get_filename_component(REPO "${REPO}" ABSOLUTE)

file(GLOB_RECURSE files "${REPO}/CMakeLists.txt" "${REPO}/cmake/*.cmake" "${REPO}/consumer/*CMakeLists.txt")
list(FILTER files EXCLUDE REGEX "/(build|out|node_modules)/")
set(violations 0)
foreach(file IN LISTS files)
  get_filename_component(base "${file}" NAME)
  if(base STREQUAL "sub0_deps_pinned.cmake")
    continue()
  endif()
  file(STRINGS "${file}" lines)
  set(number 0)
  foreach(line IN LISTS lines)
    math(EXPR number "${number} + 1")
    string(REGEX REPLACE "#.*$" "" code "${line}")   # a comment may name a SHA
    if(code MATCHES "GIT_TAG[ \t]+\"?[0-9a-fA-F]+\"?")
      string(REGEX MATCH "GIT_TAG[ \t]+\"?[0-9a-fA-F]+" hit "${code}")
      string(REGEX REPLACE "^GIT_TAG[ \t]+\"?" "" token "${hit}")
      string(LENGTH "${token}" length)
      if(length EQUAL 40)
        message(SEND_ERROR "${file}:${number}: a raw 40-hex GIT_TAG (${token}); use a tag, or put the SHA in cmake/sub0_deps_pinned.cmake with a comment")
        math(EXPR violations "${violations} + 1")
      endif()
    endif()
  endforeach()
endforeach()
if(violations GREATER 0)
  message(FATAL_ERROR "check_deps_policy: ${violations} violation(s)")
endif()
message(STATUS "check_deps_policy: ok")
