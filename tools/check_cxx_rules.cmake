# The determinism rules for C++ output paths (AGENTS.md "Code style", docs/MOCK_SQUAD.md section 8, docs/TESTING.md "Traps"), checked on the text of the sources.
# Run by the quick-tier ctest `check_cxx_rules`, or by hand:   cmake -DREPO=<repo root> -P tools/check_cxx_rules.cmake
#
#   1. no `std::mt19937`, `std::shuffle`, `std::random_device` or `<random>` outside app/ (their distributions and shuffle are implementation-defined: use bench/rng.hpp);
#   2. no `std::hash<` in lib/src (implementation-defined: libstdc++ and libc++ differ; use the fixed hash in doc_layers.cpp or the content id);
#   3. no `snprintf` or `sprintf` in lib/ and bench/ (`std::format` instead; the allowlist below is empty since slice B3);
#   4. no statement in bench/ or lib/tests with two draws from a generator (`.below(`, `.range(`, `.percent(`, `.skewed(`, `.uniform(`, `.next(`) in one unsequenced
#      expression: an argument list or an operator chain (unspecified evaluation order; docs/MOCK_SQUAD.md section 8). Draws in different declarators (`T a = r.f(), b = r.f();`),
#      different elements of a braced list (and across a `{`), a `for` header's parts, or either side of `?` are sequenced and allowed. A guard against the common shapes, not a proof.
# Comments and string literals are ignored (they may name what is banned), so a rule is about code only. Every violation is reported, then the script fails.
cmake_minimum_required(VERSION 3.24)   # script mode too: fixes the policies (CMP0054 and friends) so the script behaves the same on every CMake from 3.24
if(NOT REPO)
  set(REPO "${CMAKE_CURRENT_LIST_DIR}/..")
endif()
get_filename_component(REPO "${REPO}" ABSOLUTE)

# Files allowed a number of snprintf calls, as "path=count". Empty since slice B3 converted the last ones to std::format: any snprintf in lib/ or bench/ fails.
set(snprintfAllowed)

set(violations 0)

## Reads one source file as a list of code lines (comment text removed), keeping line numbers as list indexes. `;` and brackets are masked so the list stays intact.
function(readCodeLines file out)
  file(READ "${file}" text)
  string(REPLACE "\r" "" text "${text}")
  string(REPLACE ";" "<SEMI>" text "${text}")
  string(REPLACE "[" "<LB>" text "${text}")
  string(REPLACE "]" "<RB>" text "${text}")
  string(REPLACE "\n" "\n@" text "@${text}")   # every line starts with a marker, so a blank line is not dropped from the list and indexes stay line numbers
  string(REPLACE "\n" ";" lines "${text}")
  set(code "")
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "//.*$" "" line "${line}")
    list(APPEND code "${line}")
  endforeach()
  set(${out} "${code}" PARENT_SCOPE)
endfunction()

## Reads one source file as statements: comments and string literals removed, split at `;`, brackets masked. Sets <out>Lines (each statement's first line) and <out>Texts.
function(readStatements file out)
  file(READ "${file}" text)
  string(REPLACE "\r" "" text "${text}")
  string(REGEX REPLACE "//[^\n]*" "" text "${text}")
  string(REGEX REPLACE "\"([^\"\\n]|\\.)*\"" "\"\"" text "${text}")
  string(REGEX REPLACE "'([^'\\n]|\\.)+'" "''" text "${text}")
  string(REPLACE "[" "<LB>" text "${text}")
  string(REPLACE "]" "<RB>" text "${text}")
  string(REPLACE "\n" "<NL>" text "${text}")
  string(REPLACE ";" "\n" text "${text}")
  string(REPLACE "\n" ";" parts "${text}")
  set(lineNo 1)
  set(lines "")
  set(texts "")
  foreach(part IN LISTS parts)
    string(REGEX MATCH "^(<NL>)+" leading "${part}")
    string(REGEX MATCHALL "<NL>" leadingMarks "${leading}")
    list(LENGTH leadingMarks lead)
    math(EXPR start "${lineNo} + ${lead}")
    string(REGEX MATCHALL "<NL>" allMarks "${part}")
    list(LENGTH allMarks all)
    math(EXPR lineNo "${lineNo} + ${all}")
    list(APPEND lines ${start})
    list(APPEND texts "${part}")
  endforeach()
  set(${out}Lines "${lines}" PARENT_SCOPE)
  set(${out}Texts "${texts}" PARENT_SCOPE)
endfunction()

set(drawPattern "[.>](below|range|percent|skewed|uniform|next)[ ]*[(]")

## The most draws in one unsequenced run of a statement: split at `?` and at commas outside parentheses.
function(maxDraws statement out)
  string(LENGTH "${statement}" length)
  set(worst 0)
  set(depth 0)
  set(segment "")
  math(EXPR last "${length} - 1")
  if(length GREATER 0)
    foreach(i RANGE ${last})
      string(SUBSTRING "${statement}" ${i} 1 ch)
      # string(COMPARE) rather than `if(ch STREQUAL "(")`: a parenthesis in an if() condition is read as grouping by CMake versions before the policy that quotes arguments.
      string(COMPARE EQUAL "${ch}" "(" isOpen)
      string(COMPARE EQUAL "${ch}" ")" isClose)
      string(COMPARE EQUAL "${ch}" "?" isQuestion)
      string(COMPARE EQUAL "${ch}" "{" isBraceOpen)
      string(COMPARE EQUAL "${ch}" "}" isBraceClose)
      string(COMPARE EQUAL "${ch}" "," isComma)
      string(COMPARE EQUAL "${ch}" ":" isColon)
      if(isOpen)
        math(EXPR depth "${depth} + 1")
      elseif(isClose AND depth GREATER 0)   # a closing parenthesis with no opening one in this statement closes a `for (...;...;...)` header that was split at its `;`
        math(EXPR depth "${depth} - 1")
      endif()
      set(separator FALSE)
      if(isQuestion OR isBraceOpen OR isBraceClose OR (isComma AND depth EQUAL 0))
        set(separator TRUE)
      elseif(isColon AND depth EQUAL 0)   # the colon of `a ? b : c`, not the `::` of a scope
        math(EXPR before "${i} - 1")
        math(EXPR after "${i} + 1")
        set(prev "")
        set(next "")
        if(before GREATER_EQUAL 0)
          string(SUBSTRING "${statement}" ${before} 1 prev)
        endif()
        if(after LESS length)
          string(SUBSTRING "${statement}" ${after} 1 next)
        endif()
        string(COMPARE EQUAL "${prev}" ":" prevColon)
        string(COMPARE EQUAL "${next}" ":" nextColon)
        if(NOT prevColon AND NOT nextColon)
          set(separator TRUE)
        endif()
      endif()
      if(separator)
        string(REGEX MATCHALL "${drawPattern}" draws "${segment}")
        list(LENGTH draws count)
        if(count GREATER worst)
          set(worst ${count})
        endif()
        set(segment "")
      else()
        string(APPEND segment "${ch}")
      endif()
    endforeach()
  endif()
  string(REGEX MATCHALL "${drawPattern}" draws "${segment}")
  list(LENGTH draws count)
  if(count GREATER worst)
    set(worst ${count})
  endif()
  set(${out} ${worst} PARENT_SCOPE)
endfunction()

## Source files under the given directories (relative to REPO), as paths relative to REPO.
function(sourcesUnder out)
  set(found "")
  foreach(dir IN LISTS ARGN)
    file(GLOB_RECURSE files RELATIVE "${REPO}" "${REPO}/${dir}/*.cpp" "${REPO}/${dir}/*.hpp" "${REPO}/${dir}/*.h" "${REPO}/${dir}/*.cc")
    list(APPEND found ${files})
  endforeach()
  list(FILTER found EXCLUDE REGEX "(^|/)(build|out|_deps)/")
  list(REMOVE_DUPLICATES found)
  list(SORT found)
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

macro(report file lineNo rule text)
  string(REGEX REPLACE "^@" "" reportText "${text}")
  string(STRIP "${reportText}" reportText)
  string(REPLACE "<SEMI>" ";" reportText "${reportText}")
  message(SEND_ERROR "${file}:${lineNo}: ${rule}: ${reportText}")
  math(EXPR violations "${violations} + 1")
endmacro()

sourcesUnder(everything lib bench consumer)
sourcesUnder(libAndBench lib bench)
sourcesUnder(libSrc lib/src)
sourcesUnder(drawFiles bench lib/tests)

# 1: <random> and its engines outside app/
foreach(file IN LISTS everything)
  readCodeLines("${REPO}/${file}" lines)
  set(n 0)
  foreach(line IN LISTS lines)
    math(EXPR n "${n} + 1")
    if(line MATCHES "std::mt19937|std::shuffle|std::random_device|<random>")
      report("${file}" ${n} "no <random> outside app/ (use bench/rng.hpp)" "${line}")
    endif()
  endforeach()
endforeach()

# 2: std::hash< in lib/src
foreach(file IN LISTS libSrc)
  readCodeLines("${REPO}/${file}" lines)
  set(n 0)
  foreach(line IN LISTS lines)
    math(EXPR n "${n} + 1")
    if(line MATCHES "std::hash<")
      report("${file}" ${n} "no std::hash in lib/src (implementation-defined)" "${line}")
    endif()
  endforeach()
endforeach()

# 3: snprintf and sprintf in lib/ and bench/, up to the allowlist
foreach(file IN LISTS libAndBench)
  readCodeLines("${REPO}/${file}" lines)
  set(allowed 0)
  foreach(entry IN LISTS snprintfAllowed)
    if(entry MATCHES "^${file}=([0-9]+)$")
      set(allowed ${CMAKE_MATCH_1})
    endif()
  endforeach()
  set(seen 0)
  set(n 0)
  foreach(line IN LISTS lines)
    math(EXPR n "${n} + 1")
    if(line MATCHES "(^|[^A-Za-z0-9_])(std::)?(snprintf|sprintf)[ ]*[(]")
      math(EXPR seen "${seen} + 1")
      if(seen GREATER allowed)
        report("${file}" ${n} "no snprintf or sprintf in lib/ or bench/ (use std::format)" "${line}")
      endif()
    endif()
  endforeach()
endforeach()

# 4: two generator draws in one unsequenced expression
foreach(file IN LISTS drawFiles)
  readStatements("${REPO}/${file}" stmt)
  set(k 0)
  foreach(text IN LISTS stmtTexts)
    list(GET stmtLines ${k} lineNo)
    math(EXPR k "${k} + 1")
    string(REGEX MATCHALL "${drawPattern}" draws "${text}")
    list(LENGTH draws count)
    if(count GREATER 1)
      maxDraws("${text}" worst)
      if(worst GREATER 1)
        string(REPLACE "<NL>" " " shown "${text}")
        report("${file}" ${lineNo} "two or more generator draws in one expression (evaluation order is unspecified)" "${shown}")
      endif()
    endif()
  endforeach()
endforeach()

if(violations EQUAL 0)
  message(STATUS "check_cxx_rules: no violations")
endif()
