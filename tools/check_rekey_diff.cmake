# A one-off mechanical check for the A0 re-keying (docs/sessions/cxx23-adoption.md): every changed file under fixtures/ must be identical to its committed
# version once each `issues/<kind>/<16 hex digits>` item key is replaced by a placeholder, and only such files may have changed.
#   cmake -DREPO=<repo root> -P tools/check_rekey_diff.cmake      (run before committing the regenerated fixtures)
if(NOT REPO)
  set(REPO "${CMAKE_CURRENT_LIST_DIR}/..")
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" diff --name-only HEAD -- fixtures perf OUTPUT_VARIABLE changed OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" changed "${changed}")
set(pattern "issues/([A-Za-z0-9_-]+)/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]")
set(failures 0)
set(count 0)
foreach(file IN LISTS changed)
  if(file STREQUAL "")
    continue()
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" show "HEAD:${file}" OUTPUT_VARIABLE before COMMAND_ERROR_IS_FATAL ANY)
  file(READ "${REPO}/${file}" after)
  string(REGEX REPLACE "${pattern}" "issues/\\1/@key@" before "${before}")
  string(REGEX REPLACE "${pattern}" "issues/\\1/@key@" after "${after}")
  if(before STREQUAL after)
    math(EXPR count "${count} + 1")
  else()
    message(SEND_ERROR "${file} changed by more than item keys")
    math(EXPR failures "${failures} + 1")
  endif()
endforeach()
if(failures EQUAL 0)
  message(STATUS "check_rekey_diff: ${count} changed file(s), all identical modulo issues/<kind>/<hex> keys")
endif()
